{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easy-local-mcp-relay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "McpRelay" },
      { "name": "ZONE", "class_name": "ZoneManager" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["McpRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["ZoneManager"] }
  ]
}
